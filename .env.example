# Same Supabase project as the web dashboard (apps/web/.env in the main repo).
# EXPO_PUBLIC_ prefix is Expo's convention for vars inlined into the client
# bundle -- the anon key is safe to expose, RLS enforces access per role.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Express backend (coreva_logistics_brokerage_dashboard_back_end) -- used
# for the BOL OCR endpoint. localhost won't work from a physical device;
# use your Mac's LAN IP for on-device testing, or the Render URL once
# deployed.
EXPO_PUBLIC_API_BASE_URL=

# Phone number the "Call Dispatch" button on the Activate Shipment screen
# opens. Real dispatch<->driver chat is a later phase -- this is the
# pragmatic stand-in for now.
EXPO_PUBLIC_DISPATCH_PHONE=
